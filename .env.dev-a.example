# Instance A of the sync dev rig (Plan F, F-09). Copy to `.env.dev-a`.
#
# This file configures ONLY instance A's host-run API (tsx watch). It is not
# passed to `docker compose` — db-a/db-b/app-b's config lives entirely in
# docker-compose.dev.yml as fixed dev-only defaults (JWT_SECRET_B /
# INVITE_CODE_B there if you need to override instance B's).
#
# A runs on the HOST, so DATABASE_URL points at the published port of the
# db-a container from docker-compose.dev.yml — NOT at the compose-internal
# hostname `db`, which does not resolve outside the compose network.

JWT_SECRET=devsecret-devsecret-devsecret-32ch
DATABASE_URL=postgresql://weltbon:devpassword@127.0.0.1:5441/weltbon
INVITE_CODE=local-invite-code
PORT=3000

# Needed only to register a sync remote (POST /api/sync/remotes encrypts the
# peer's PAT at rest). A
# deliberately obvious non-key: config.ts only checks /^[0-9a-f]{64}$/, so this
# satisfies the validator while being impossible to mistake for a real key or to
# paste into a deployment unnoticed. Generate a real one with `openssl rand -hex 32`.
LLM_KEY_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# NOT OPTIONAL FOR THIS RIG. `LocalStorageBackend` defaults to `/uploads` — the
# Docker volume mount point, which instance A, a HOST process, cannot create:
# every image upload 500s with `EACCES: permission denied, mkdir '/uploads'`.
# That is silent from the rig's point of view until you try the one path the rig
# exists to exercise, since a sync whose universe holds an image is the case
# Plan F0 was written for. The path is resolved relative to the API's cwd
# (`api/`), so this lands at the repo root; `.uploads-dev-*` is gitignored.
UPLOADS_DIR=../.uploads-dev-a
