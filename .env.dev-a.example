# Instance A of the sync dev rig (Plan F, F-09). Copy to `.env.dev-a`.
#
# A runs on the HOST, so DATABASE_URL points at the published port of the
# db-a container from docker-compose.dev.yml — NOT at the compose-internal
# hostname `db`, which does not resolve outside the compose network.
#
# This file is ALSO passed to `docker compose -f docker-compose.dev.yml
# --env-file .env.dev-a ...` for db-a/db-b/app-b's variable interpolation —
# that's why instance B's JWT_SECRET/INVITE_CODE below use _B-suffixed names
# instead of reusing A's. If they shared a name, A's value would win over
# app-b's own compose-file fallback (see the comment on app-b in
# docker-compose.dev.yml). JWT_SECRET_B is also a genuinely different value
# from JWT_SECRET, not just a different name — two independent instances
# would never share a signing secret, and sharing one here would let a token
# minted on A validate on B, which could mask a real cross-instance auth bug
# during manual sync verification.

JWT_SECRET=devsecret-devsecret-devsecret-32ch
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql://weltbon:devpassword@localhost:5441/weltbon
INVITE_CODE=local-invite-code
PORT=3000

# Instance B (containerized peer) — read by docker-compose.dev.yml's app-b
# service only, never by the host API above.
JWT_SECRET_B=peer-jwtsecret-peer-jwtsecret-32ch
INVITE_CODE_B=peer-invite-code
