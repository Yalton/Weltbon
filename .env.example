# Weltbon environment configuration.
# Copy this file to `.env` and fill in real values before running `docker compose up -d`.

# REQUIRED — JWT signing secret. Generate with: openssl rand -hex 32
# Must be at least 32 characters (api/src/config.ts:18 enforces).
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# REQUIRED — Postgres password used both by the `db` service and by the API's DATABASE_URL.
POSTGRES_PASSWORD=changeme

# REQUIRED — Postgres connection string. Service-name DNS resolves `db` inside the compose network.
DATABASE_URL=postgresql://weltbon:changeme@db:5432/weltbon

# REQUIRED for first-boot self-register — pre-seeds the invite_codes table on cold start
# (only if the table is empty). After first use, generate further invites with:
#   docker compose exec app node dist/scripts/invite-new.js
INVITE_CODE=replace-with-any-string-for-first-account

# OPTIONAL — API port inside the container. Compose maps host:3000 -> container:3000 by default.
PORT=3000

# OPTIONAL — Override the path to Chromium. The container ships /usr/bin/chromium and sets this
# automatically; only set this for bare-Node runs outside Docker.
# CHROMIUM_PATH=/usr/bin/chromium
