# Copy to .env and fill in real values before running the app.
# Generate JWT_SECRET with: openssl rand -hex 32
DATABASE_URL=postgresql://weltbon:weltbon@127.0.0.1:5432/weltbon
JWT_SECRET=replace-with-openssl-rand-hex-32-minimum-32-chars
POSTGRES_PASSWORD=weltbon
PORT=3000
# Optional — only used by later phases
CHROMIUM_PATH=/usr/bin/chromium-browser
